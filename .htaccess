# .htaccess raiz - Redireciona tudo para /public
# Compativel com Apache, LiteSpeed (CloudLinux/cPanel) e Imunify360.
#
# Se o DocumentRoot do vhost ja aponta para /public, este arquivo nao eh necessario.
# Caso contrario (ex.: cPanel padrao), este arquivo oculta /public da URL.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona tudo para public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloquear acesso direto a arquivos sensiveis
<FilesMatch "\.(env|lock|json|md|yml|yaml|xml|log|sql|sh|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acesso a pastas sensiveis
<IfModule mod_rewrite.c>
    RewriteRule ^(\.git|storage|config|database|app|bootstrap|vendor|node_modules|frontend|docs)(/|$) - [F,L]
</IfModule>

# Negar listagem de diretorios
Options -Indexes

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php56” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php56 .php .php5 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
