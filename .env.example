APP_NAME="KDKhost Cobranca WhatsApp SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cobranca.kdkhost.com.br
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# ==============================================================================
# WHATSAPP CLOUD API OFICIAL DA META (GRAPH API v21.0)
# ==============================================================================
GRAPH_API_VERSION=v21.0
META_GRAPH_VERSION=v21.0
META_PHONE_NUMBER_ID=123456789012345
META_WABA_ID=987654321098765
META_ACCESS_TOKEN=EAAG...seu_system_user_token_permanente_aqui...
META_APP_SECRET=seu_app_secret_meta_for_developers
META_VERIFY_TOKEN=kdkhost_meta_webhook_secret_2026
META_WEBHOOK_VERIFY_TOKEN=kdkhost_meta_webhook_secret_2026

# ==============================================================================
# MERCADO PAGO SDK v2 (CHECKOUT TRANSPARENTE, PIX DINÂMICO & ASSINATURAS SAAS)
# ==============================================================================
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_SECRET=seu_secret_webhook_mercadopago_aqui
MERCADOPAGO_SANDBOX=false

# Chaves Mercado Pago (Alias suportados)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ==============================================================================
# BANCO DE DADOS (MySQL / MariaDB Nativo cPanel ou Docker)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kdkhost_whatsapp
DB_USERNAME=kdkhost_user
DB_PASSWORD=kdkhost_secret_password_2026
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# REDIS & FILAS (Para BullMQ no Docker ou VPS)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cron interno (cPanel / Phusion Passenger)
CRON_HEARTBEAT_SECONDS=60
CRON_EXTERNAL_TOKEN=kdkhost_cron_token_seguro_2026

# Upload (controle pelo admin tambem)
UPLOAD_MAX_SIZE_MB=50

# Evolution API (cliente WhatsApp em Go)
EVOLUTION_BASE_URL=https://evolution.example.com
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE_API_KEY=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=default
EVOLUTION_WEBHOOK_TOKEN=
WHATSAPP_FEATURE_MESSAGE_PRESENCE=false
WHATSAPP_FEATURE_MESSAGE_DELETE=false
WHATSAPP_FEATURE_POLL_RESULTS=false
WHATSAPP_FEATURE_BUTTON_REVIEW_AND_PAY=false
WHATSAPP_FEATURE_COMMUNITY=false
WHATSAPP_FEATURE_NEWSLETTER=false
WHATSAPP_FEATURE_CALL_REJECT=false

WHATSAPP_ANTI_BAN_ENABLED=true
WHATSAPP_ANTI_BAN_TIMEZONE=America/Sao_Paulo

WHATSAPP_BUSINESS_HOURS_ENABLED=true
WHATSAPP_BUSINESS_HOURS_START=08:00
WHATSAPP_BUSINESS_HOURS_END=20:00

WHATSAPP_LIMIT_PER_MINUTE=2
WHATSAPP_LIMIT_PER_HOUR=35
WHATSAPP_LIMIT_PER_DAY=250

WHATSAPP_RECIPIENT_COOLDOWN_MINUTES=30
WHATSAPP_MESSAGE_COOLDOWN_MINUTES=45
WHATSAPP_CAMPAIGN_COOLDOWN_MINUTES=90
WHATSAPP_MEDIA_COOLDOWN_MINUTES=20

WHATSAPP_HUMAN_DELAY_ENABLED=true
WHATSAPP_HUMAN_DELAY_MIN_SECONDS=8
WHATSAPP_HUMAN_DELAY_MAX_SECONDS=28

WHATSAPP_EVOLUTION_DELAY_MIN_MS=1500
WHATSAPP_EVOLUTION_DELAY_MAX_MS=4500

WHATSAPP_RELEASE_WHEN_LIMITED_SECONDS=300
WHATSAPP_BLOCK_GROUP_SENDS=true
WHATSAPP_MINIMUM_MESSAGE_CHARS=2
WHATSAPP_STOP_KEYWORDS=stop,parar,cancelar,sair,remover,nao quero,descadastrar
WHATSAPP_WARMUP_ENABLED=true
WHATSAPP_WARMUP_DAYS=30
WHATSAPP_WARMUP_LIMIT_DAY_1=10
WHATSAPP_WARMUP_LIMIT_DAY_2=20
WHATSAPP_WARMUP_LIMIT_DAY_3=30
WHATSAPP_WARMUP_LIMIT_DAYS_4_7=50
WHATSAPP_WARMUP_LIMIT_DAYS_8_15=100
WHATSAPP_WARMUP_LIMIT_DAYS_16_30=150
WHATSAPP_TEXT_LIMIT_PER_HOUR=35
WHATSAPP_IMAGE_LIMIT_PER_HOUR=20
WHATSAPP_AUDIO_LIMIT_PER_HOUR=15
WHATSAPP_VIDEO_LIMIT_PER_HOUR=10
WHATSAPP_DOCUMENT_LIMIT_PER_HOUR=15
WHATSAPP_BUTTONS_LIMIT_PER_HOUR=20
WHATSAPP_LIST_LIMIT_PER_HOUR=20
WHATSAPP_POLL_LIMIT_PER_HOUR=10

WHATSAPP_RISK_MEDIUM=21
WHATSAPP_RISK_HIGH=51
WHATSAPP_RISK_CRITICAL=81
WHATSAPP_RISK_BLOCK_ABOVE=95

WHATSAPP_WEBHOOK_SECRET_REQUIRED=true
WHATSAPP_WEBHOOK_SIGNATURE_REQUIRED=true
WHATSAPP_WEBHOOK_TIMESTAMP_REQUIRED=true
WHATSAPP_WEBHOOK_MAX_AGE_SECONDS=300
WHATSAPP_API_RATE_LIMIT_PER_MINUTE=30

# WHMCS
WHMCS_WEBHOOK_SIGNATURE_REQUIRED=true

# Gateways de pagamento
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

EFIPRO_CLIENT_ID=
EFIPRO_CLIENT_SECRET=
EFIPRO_SANDBOX=true

SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_MERCHANT_CODE=

# ViaCEP (sem chave - apenas configuravel)
VIACEP_BASE_URL=https://viacep.com.br/ws

# PWA - chaves WebPush (geradas pelo admin)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Segurança / WAF ──────────────────────────────────────────────────────────
# Modo do WAF: off | detect | block
# off    = WAF desligado
# detect = Detecta e registra, mas NÃO bloqueia (recomendado para implantação)
# block  = Detecta, registra e bloqueia com 403
SECURITY_WAF_ENABLED=true
SECURITY_WAF_MODE=detect
SECURITY_WAF_ADMIN_ENABLED=false
SECURITY_WAF_LOG_PAYLOAD=true
SECURITY_WAF_LOG_HEADERS=true

# Sessão segura (true em produção com HTTPS)
SESSION_SECURE_COOKIE=true
