{
    "name": "cobranca-whatsapp-frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Frontend publico - React 18 + TypeScript + Tailwind CSS 4",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build --outDir ../public/build --emptyOutDir",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write src"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "clsx": "^2.1.1",
        "framer-motion": "^12.39.0",
        "lucide-react": "^1.16.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.27.0",
        "sweetalert2": "^11.26.24",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.13.0",
        "@typescript-eslint/parser": "^8.13.0",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "^9.14.0",
        "prettier": "^3.3.3",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.6.3",
        "vite": "^5.4.10"
    }
}
