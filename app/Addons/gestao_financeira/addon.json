                "order": 57
            },
            {
                "title": "Contas",
                "icon": "bi-bank",
                "route": "admin.gestao-financeira.accounts.index",
                "order": 58
            },
            {
                "title": "Relatórios",
                "icon": "bi-file-earmark-bar-graph",
                "route": "admin.gestao-financeira.reports.index",
                "order": 59
            }
        ]
    },
